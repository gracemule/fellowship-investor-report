# Copy to .env and fill in. .env is gitignored; this example file is not.
# On Render these are set in the service's Environment tab instead (see render.yaml).

# --- Database (required) ----------------------------------------------------
# Neon Postgres, the POOLED connection string. Holds the agent's checkpoints, the fact ledger,
# the report, the synced source files and every version of the rendered report.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- Model provider ---------------------------------------------------------
# deepseek (default) or anthropic. Only the active provider's key is required.
CHUI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# If the primary provider is unreachable after several retries, carry on with this one (needs its key).
# CHUI_FALLBACK_PROVIDER=anthropic
# Optional model overrides (defaults shown).
# DEEPSEEK_MODEL=deepseek-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
# DeepSeek thinking mode: off by default (the documented tool-calling path).
# CHUI_THINKING=on
# When the conversation is trimmed. The model's real context window is read from the provider. Once the conversation
# fills this share of it, old tool results are replaced by a stub; at the second share, old exchanges are condensed
# (rewriting old messages costs you the provider's prompt cache, so later is cheaper). Or set an absolute token count.
# CHUI_CONTEXT_FRACTION=0.5
# CHUI_CONTEXT_DISCARD_FRACTION=0.8
# CHUI_CONTEXT_BUDGET=
# Subagents (web research runs in their own contexts). Researchers in parallel, and an optional cheaper model for them.
# CHUI_SUBAGENT_PARALLEL=3
# CHUI_SUBAGENT_MODEL=
# Memory (a small server): estimated MB of source workbooks kept open at once, and how long a Stop waits for the step in progress.
# CHUI_WORKBOOK_CACHE_MB=220
# CHUI_STOP_GRACE=90

# --- PDF conversion ---------------------------------------------------------
# auto (default): LibreOffice if installed here, else the converter service if configured, else iLoveAPI if a key is set.
# Or force: libreoffice | remote | iloveapi.
# CHUI_PDF_CONVERTER=auto
# The converter service (LibreOffice on a host of its own, src/chui_reporter/converter; see render.converter.yaml).
# The same token goes in both services. The brand font is sent with each request, never stored in an image.
# CHUI_CONVERTER_URL=https://chui-converter.onrender.com
# CHUI_CONVERTER_TOKEN=
# Hosted fallback. It converts but does NOT keep the Larken font (licence flag fsType 4), so PDFs would not look as designed.
# Check with:  python -m chui_reporter.render.check_converter
# ILOVEAPI_PUBLIC_KEY=
# CHUI_EMBED_FONTS=1

# --- Web search (macro data) ------------------------------------------------
# Tavily is the default; Brave takes over automatically when Tavily's credit is used up, and Tavily
# returns by itself once its allowance renews. Either key alone also works.
# Brave bills your card past its free monthly credit: set a spending limit in its dashboard.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# CHUI_SEARCH_ORDER=tavily,brave

# --- Web app ----------------------------------------------------------------
# The shared password the team signs in with. REQUIRED unless CHUI_ENV=dev.
CHUI_ACCESS_PASSWORD=
# Signs the session cookie. Any long random string; generated automatically on Render.
# CHUI_SESSION_SECRET=
# dev = no password and the development folder helper (loopback only). Never set this in production.
# CHUI_ENV=dev
# Where the server keeps its working copy of the synced folder and rendered files.
# CHUI_WORKDIR=.workspace
# Saved agent memory (checkpoints): newest kept per conversation, steps between prunes, and the budget (MB of saved payload)
# past which the longest-idle conversations' state is dropped. See runtime/retention.py.
# CHUI_CHECKPOINTS_KEPT=2
# CHUI_PRUNE_EVERY=20
# CHUI_CHECKPOINT_BUDGET_MB=150
# Database schema (default chui). A different one runs an isolated copy beside the real data, for trying things out.
# CHUI_SCHEMA=chui
# Reporting period the workspace starts on.
# CHUI_PERIOD=2026Q2
# How often an idle server looks for runs a dead process left behind (default 30 s; 3600 s when CHUI_ENV=production,
# so a scale-to-zero database is not kept awake).
# CHUI_JANITOR_SECONDS=
